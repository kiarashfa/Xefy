---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Catalog from '../../components/Catalog.svelte';
import { catalogRecord, getSite } from '../../lib/content/site.ts';
import { COURSES, CUISINES, METHODS, ALLERGEN_TERMS } from '../../schemas/taxonomy.ts';

/**
 * The full catalogue.
 *
 * Only the first page of dishes is rendered into the HTML; the island fetches
 * the whole light export (`catalog-index.json`) once it loads, so this page
 * stays the same weight at two thousand dishes as at two hundred. Every dish is
 * still reachable without JavaScript through its cuisine, course and method
 * pages, and through the sitemap.
 */
const site = await getSite();
const records = site.recipes.map(catalogRecord).sort((a, b) => a.title.localeCompare(b.title));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Recipes · Xefy"
  description="Every dish on Xefy, with computed timing, nutrition and diet labels."
>
  <SiteHeader />
  <main id="main" class="wrap">
    <div class="page-head">
      <h1 class="page-title">Recipes</h1>
      <p class="page-lede">
        {records.length} dishes, every one with its timing, nutrition and diet labels computed
        rather than typed.
      </p>
    </div>
    <Catalog
      client:load
      initial={records.slice(0, 48)}
      total={records.length}
      src={`${base}catalog-index.json`}
      base={base}
      cuisines={CUISINES}
      courses={COURSES}
      methods={METHODS}
      allergens={ALLERGEN_TERMS}
    />
  </main>
  <SiteFooter />
  <script>
    import { initInteractions } from '../../lib/client/interactions.ts';
    initInteractions();
  </script>
</BaseLayout>
