---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import RecipeCards from '../../components/RecipeCards.astro';
import { catalogRecord, getSite } from '../../lib/content/site.ts';

const site = await getSite();
const recipes = site.recipes.map(catalogRecord);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Recipes — Xefy"
  description="Every dish on Xefy, with computed timing, nutrition and diet labels."
>
  <SiteHeader />
  <main id="main" class="wrap">
    <div class="page-head">
      <h1 class="page-title">Recipes</h1>
      <p class="page-lede">
        {recipes.length} dishes. The homepage has the same set with filters on it.
      </p>
    </div>
    <RecipeCards recipes={recipes} base={base} />
  </main>
  <SiteFooter />
  <script>
    import { initInteractions } from '../../lib/client/interactions.ts';
    initInteractions();
  </script>
</BaseLayout>
