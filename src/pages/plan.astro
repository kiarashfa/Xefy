---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PlanView from '../components/PlanView.svelte';

/**
 * The week view of the Plan. §8.5
 *
 * `client:only` rather than a hydrated island: there is nothing true to render
 * on the server here. Every figure on this page comes from one browser's
 * storage, so server-rendering an empty plan would paint a state that is
 * usually wrong and then replace it — a layout shift in exchange for markup
 * nobody, crawler included, has any use for.
 *
 * noindex: a user-state page has no crawlable content. It is deliberately not
 * disallowed in robots.txt — a blocked page is never fetched, so the tag would
 * never be seen. §9.
 */
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Your plan — Xefy"
  description="Recipes you intend to cook, and the shopping list that falls out of them."
  noindex
>
  <SiteHeader />
  <main id="main" class="wrap">
    <div class="page-head">
      <h1 class="page-title">Your plan</h1>
      <p class="page-lede">
        What you mean to cook, by day, with the week's arithmetic done. Nothing here is stored
        beyond the dishes and the portions — every figure is worked out again each time you open it.
      </p>
    </div>

    <PlanView client:only="svelte" base={base} />

    <noscript>
      <p class="empty-state">
        A plan is held in your own browser rather than on a server, so this page needs JavaScript to
        read it. Everything else on Xefy works without.
      </p>
    </noscript>
  </main>
  <SiteFooter />
  <script>
    import { initInteractions } from '../lib/client/interactions.ts';
    initInteractions();
  </script>
</BaseLayout>
