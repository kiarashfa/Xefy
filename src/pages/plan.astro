---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

/**
 * The Plan itself is Phase 7. The nav item ships now (§19.4) so the header is
 * not widened later, which means this route has to exist rather than 404 — and
 * the empty state is the most common view of this page anyway, so it is the
 * right thing to design first.
 *
 * noindex: a user-state page has no crawlable content. It is deliberately not
 * disallowed in robots.txt — a blocked page cannot be fetched, so the tag would
 * never be seen. §9.
 */
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Your plan — Xefy"
  description="Recipes you intend to cook, and the shopping list that falls out of them."
  noindex
>
  <SiteHeader />
  <main class="wrap">
    <div class="page-head">
      <h1 class="page-title">Your plan</h1>
      <p class="page-lede">
        Nothing planned yet. Add a dish from any recipe page and it will appear here, with the
        shopping list worked out from the serving counts you chose.
      </p>
    </div>
    <p class="empty-state">
      Start from <a href={base}>the catalogue</a>, or from
      <a href={`${base}what-can-i-make/`}>what you already have</a>.
    </p>
    <p class="source-line">
      A plan lives in this browser and nowhere else — there is no account behind it, so clearing
      site data or switching device will lose it.
    </p>
  </main>
  <footer class="site-footer">
    <div class="wrap footer-inner"><span>Xefy</span><span>Nutrition from USDA FoodData Central.</span></div>
  </footer>
  <script>
    import { initInteractions } from '../lib/client/interactions.ts';
    initInteractions();
  </script>
</BaseLayout>
