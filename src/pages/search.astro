---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

/**
 * Search, as a page.
 *
 * It was an overlay dialog, which cost a focus trap, an inert-background claim
 * to get right, and a close button positioned over borrowed markup — all so
 * that results could appear on top of a page nobody was reading any more.
 * A page has none of that: results are linkable, the back button works, and the
 * only chrome is the field itself.
 *
 * `noindex` for the same reason the Plan carries it — a search page has no
 * content of its own, and an indexed one is thin by construction. It stays
 * crawlable so the tag is actually seen.
 */
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Search — Xefy"
  description="Search every dish and ingredient on Xefy, including regional names and alternate spellings."
  noindex
>
  <SiteHeader />

  <main id="main" class="wrap">
    <div class="page-head">
      <h1 class="page-title">Search</h1>
      <p class="page-lede">
        Every dish and ingredient, including regional names and the spellings people actually type.
      </p>
    </div>

    <div class="search-page">
      <div id="pagefind-search"></div>
      <noscript>
        <p class="empty-state">
          Search needs JavaScript. Everything it would find is reachable from
          <a href={`${base}recipes/`}>Recipes</a> and <a href={`${base}ingredients/`}>Ingredients</a>.
        </p>
      </noscript>
    </div>
  </main>

  <SiteFooter />

  <link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
  <script is:inline define:vars={{ base }}>
    // Pagefind's assets are produced by the build, so this is inert in
    // `astro dev` and live in a real build. The index reads rendered HTML,
    // which is what makes alternate and search-only names findable.
    (async () => {
      const mount = document.getElementById('pagefind-search');
      try {
        await import(`${base}pagefind/pagefind-ui.js`);
        new window.PagefindUI({
          element: '#pagefind-search',
          showSubResults: true,
          showImages: false,
          /*
           * Required, and its absence is why search never returned anything.
           * The UI script loads the search core itself, from a root-relative
           * `/pagefind/` unless told otherwise — which 404s on a site served
           * from a repository subpath. The failure is silent in the UI: the
           * field works, the query runs, and it sits on "Searching…" forever.
           */
          bundlePath: `${base}pagefind/`,
        });
      } catch {
        mount.textContent = 'Search is available on the published site.';
        return;
      }

      // A search result should be a link somebody can send, so the term comes
      // from the URL and goes back into it as it changes.
      const input = mount.querySelector('input');
      if (!input) return;

      const initial = new URLSearchParams(location.search).get('q');
      if (initial) {
        input.value = initial;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
      input.focus();

      let timer;
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          const url = new URL(location.href);
          if (input.value) url.searchParams.set('q', input.value);
          else url.searchParams.delete('q');
          history.replaceState(null, '', url);
        }, 400);
      });
    })();
  </script>
</BaseLayout>
