---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ReverseSearchTeaser from '../components/ReverseSearchTeaser.svelte';
import { catalogRecord, getSite } from '../lib/content/site.ts';
import { weeklyPick } from '../lib/showcase.ts';
import { COURSES, CUISINES } from '../schemas/taxonomy.ts';

/**
 * The homepage: a way in, not the whole catalogue.
 *
 * It holds a fixed amount whatever the size of the catalogue — a featured
 * handful that changes weekly, the busiest ways to browse, and the door to the
 * full list at `/recipes/`. A homepage that rendered every dish would be the
 * slowest page on the site by the time there were a thousand of them.
 */
const site = await getSite();
const records = site.recipes.map(catalogRecord);
const base = import.meta.env.BASE_URL;

/**
 * The teaser's ingredients are the ones the catalogue actually leans on, not a
 * hand-picked list — so it keeps naming useful things as the catalogue grows
 * instead of quietly going stale. Staples are excluded for the same reason the
 * reverse search excludes them: nobody wants to tick "salt".
 */
const useCount = new Map<string, number>();
for (const record of records) {
  for (const id of record.ingredients) {
    if (!site.staples.includes(id)) useCount.set(id, (useCount.get(id) ?? 0) + 1);
  }
}
const teaserIngredients = [...useCount.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 10)
  .map(([id]) => ({ id, name: site.ingredients.find((i) => i.id === id)?.name ?? id }))
  .sort((a, b) => a.name.localeCompare(b.name));

/* Only dishes with a photograph: a featured card is the one place a blank tile
   would be the first thing a visitor sees. */
const featured = weeklyPick(
  records.filter((r) => r.image),
  8,
);

const withCounts = (terms: readonly { id: string; label: string }[], axis: 'cuisine' | 'course') =>
  terms
    .map((t) => ({ ...t, count: records.filter((r) => r.tags[axis].includes(t.id)).length }))
    .filter((t) => t.count > 0);

/* The twelve cuisines with the most dishes, then listed alphabetically: the
   busiest doors, in an order a reader can scan. */
const cuisines = withCounts(CUISINES, 'cuisine')
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))
  .slice(0, 12)
  .sort((a, b) => a.label.localeCompare(b.label));
const allCuisines = withCounts(CUISINES, 'cuisine').length;
const courses = withCounts(COURSES, 'course').sort((a, b) => a.label.localeCompare(b.label));

const cuisineLabel = (id: string) => CUISINES.find((c) => c.id === id)?.label ?? id;
const minutes = (m: number) => (m < 60 ? `${m}m` : `${Math.floor(m / 60)}h ${m % 60 || ''}`.trim());

const title = 'Xefy · Recipe encyclopedia';
const description =
  'One page per dish. Every quantity, nutrition figure and timing is derived from structured data and recomputes when you change the serving count or the units.';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />

  <main id="main" class="wrap">
    <div class="page-head">
      <h1 class="page-title">Every dish, all the numbers</h1>
      <p class="page-lede">
        {records.length} dishes. Change the servings and every quantity moves with you; switch to US
        customary and the temperatures in the method change too. Nothing here is typed by hand.
      </p>
      <ReverseSearchTeaser client:visible ingredients={teaserIngredients} base={base} />
    </div>

    <section class="home-section" aria-labelledby="featured-title">
      <div class="home-section-head">
        <h2 id="featured-title" class="home-section-title">Featured this week</h2>
        <a class="home-section-link" href={`${base}recipes/`}>All {records.length} recipes →</a>
      </div>
      <ul class="card-grid">
        {
          featured.map((r) => (
            <li>
              <a class="card" href={`${base}recipes/${r.slug}/`}>
                <span class="card-image">
                  <img src={`${base}${r.image}`} alt="" width="800" height="800" loading="lazy" />
                </span>
                <span class="card-body">
                  <span class="card-eyebrow">
                    {cuisineLabel(r.tags.cuisine[0]!)} · {r.style}
                  </span>
                  <span class="card-title">{r.title}</span>
                  <span class="card-meta">
                    {minutes(r.totalMin)} · {r.kcalPerServing} kcal · {r.difficulty}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="home-section" aria-labelledby="cuisine-title">
      <div class="home-section-head">
        <h2 id="cuisine-title" class="home-section-title">Browse by cuisine</h2>
        <a class="home-section-link" href={`${base}cuisines/`}>All {allCuisines} cuisines →</a>
      </div>
      <ul class="listing">
        {
          cuisines.map((t) => (
            <li>
              <a href={`${base}cuisines/${t.id}/`}>
                {t.label}
                <span class="count">{t.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="home-section" aria-labelledby="course-title">
      <div class="home-section-head">
        <h2 id="course-title" class="home-section-title">Browse by course</h2>
        <a class="home-section-link" href={`${base}courses/`}>All courses →</a>
      </div>
      <ul class="listing">
        {
          courses.map((t) => (
            <li>
              <a href={`${base}courses/${t.id}/`}>
                {t.label}
                <span class="count">{t.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="home-cta">
      <a class="catalog-more-button" href={`${base}recipes/`}>Browse all {records.length} recipes</a>
    </div>
  </main>

  <SiteFooter />

  <script>
    import { initInteractions } from '../lib/client/interactions.ts';
    initInteractions();
  </script>
</BaseLayout>
