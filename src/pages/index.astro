---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Catalog from '../components/Catalog.svelte';
import ReverseSearchTeaser from '../components/ReverseSearchTeaser.svelte';
import { catalogRecord, getSite } from '../lib/content/site.ts';
import { COURSES, CUISINES, METHODS, ALLERGEN_TERMS } from '../schemas/taxonomy.ts';

/**
 * The homepage: the whole catalogue, filterable.
 *
 * A photo-forward card grid is the default because the imagery is the site's
 * warmth, with a dense table a click away for people comparing rather than
 * browsing. Both read the light catalogue export — never the per-recipe detail
 * files, which would tax this page for a feature it does not use.
 */
const site = await getSite();
const recipes = site.recipes.map(catalogRecord);
const base = import.meta.env.BASE_URL;

/**
 * The teaser's ingredients are the ones the catalogue actually leans on, not a
 * hand-picked list — so it keeps naming useful things as the catalogue grows
 * instead of quietly going stale. Staples are excluded for the same reason the
 * reverse search excludes them: nobody wants to tick "salt".
 */
const useCount = new Map<string, number>();
for (const record of recipes) {
  for (const id of record.ingredients) {
    if (!site.staples.includes(id)) useCount.set(id, (useCount.get(id) ?? 0) + 1);
  }
}
const teaserIngredients = [...useCount.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 10)
  .map(([id]) => ({ id, name: site.ingredients.find((i) => i.id === id)?.name ?? id }))
  .sort((a, b) => a.name.localeCompare(b.name));

const title = 'Xefy — a recipe encyclopedia where the numbers are computed';
const description =
  'One page per dish. Every quantity, nutrition figure and timing is derived from structured data and recomputes when you change the serving count or the units.';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />

  <main id="main" class="wrap">
    <div class="page-head">
      <h1 class="page-title">Every dish, all the numbers</h1>
      <p class="page-lede">
        {recipes.length} dishes. Change the servings and every quantity moves with you; switch to US
        customary and the temperatures in the method change too. Nothing here is typed by hand.
      </p>
      <ReverseSearchTeaser client:visible ingredients={teaserIngredients} base={base} />
    </div>

    <Catalog
      client:load
      recipes={recipes}
      base={base}
      cuisines={CUISINES}
      courses={COURSES}
      methods={METHODS}
      allergens={ALLERGEN_TERMS}
    />
  </main>

  <SiteFooter />

  <script>
    import { initInteractions } from '../lib/client/interactions.ts';
    initInteractions();
  </script>
</BaseLayout>
