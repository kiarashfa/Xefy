---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ReverseSearch from '../components/ReverseSearch.svelte';
import { catalogRecord, getSite } from '../lib/content/site.ts';

const site = await getSite();
const base = import.meta.env.BASE_URL;
const recipes = site.recipes.map(catalogRecord);
const ingredients = site.ingredients.map((i) => ({ id: i.id, name: i.name, category: i.category }));
---

<BaseLayout
  title="What can I make? — Xefy"
  description="Tick what you have and see which dishes are within reach, ranked by how close each one is."
>
  <SiteHeader />
  <main id="main" class="wrap">
    <div class="page-head">
      <h1 class="page-title">What can I make?</h1>
      <p class="page-lede">
        Tick what is in the fridge. Dishes are ranked by how much of each one you already have, and
        every result says exactly what is missing.
      </p>
    </div>
    <ReverseSearch
      client:load
      recipes={recipes}
      ingredients={ingredients}
      staples={site.staples}
      base={base}
    />
  </main>
  <SiteFooter />
  <script>
    import { initInteractions } from '../lib/client/interactions.ts';
    initInteractions();
  </script>
</BaseLayout>
