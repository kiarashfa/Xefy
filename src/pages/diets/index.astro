---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { catalogRecord, getSite } from '../../lib/content/site.ts';
import { DIETS } from '../../schemas/taxonomy.ts';

const site = await getSite();
const records = site.recipes.map(catalogRecord);
const base = import.meta.env.BASE_URL;
const terms = DIETS.map((t) => ({
  ...t,
  count: records.filter((r) => r.diets.includes(t.id)).length,
})).filter((t) => t.count > 0);
---

<BaseLayout title="Diet — Xefy" description="Browse Xefy by computed diet label.">
  <SiteHeader />
  <main id="main" class="wrap">
    <div class="page-head">
      <h1 class="page-title">Diet</h1>
      <p class="page-lede">
        Every label here is computed from the ingredient records rather than applied by hand, so a
        dish qualifies only if all of it does. Only terms with a dish behind them are listed.
      </p>
    </div>
    <ul class="listing">
      {
        terms.map((t) => (
          <li>
            <a href={`${base}diets/${t.id}/`}>
              {t.label}
              <span class="count">{t.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <SiteFooter />
  <script>
    import { initInteractions } from '../../lib/client/interactions.ts';
    initInteractions();
  </script>
</BaseLayout>
