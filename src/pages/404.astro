---
/**
 * The 404.
 *
 * GitHub Pages serves `/404.html` for any path it cannot resolve, including
 * under a project prefix, so this needs nothing beyond existing at the root of
 * the build, and the host still answers with a real 404 status.
 *
 * `noindex`, and so out of the site's own search too: a soft 404 indexed under
 * its own title is worse than none.
 *
 * The same shape as the sibling sites' 404s: the status, a plain headline, one
 * line in the site's own voice, then the ways out.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const base = import.meta.env.BASE_URL;

/*
 * Chosen at build time rather than in the browser: a 404 is the page most
 * likely to be reached by something that runs no JavaScript, so it has to be
 * complete in its own HTML.
 */
const lines = [
  'This page was never on the menu.',
  'Nothing is cooking at this address.',
  'The recipe that led here called for a page we do not have.',
];
const quip = lines[Math.floor(Math.random() * lines.length)]!;

const ways = [
  { href: `${base}recipes/`, label: 'Recipes' },
  { href: `${base}ingredients/`, label: 'Ingredients' },
  { href: `${base}what-can-i-make/`, label: 'What can I make' },
  { href: `${base}about/`, label: 'About' },
];
---

<BaseLayout title="Not found · Xefy" description="No page lives at this address." noindex>
  <SiteHeader />

  <main id="main" class="wrap notfound">
    <p class="notfound-code">404</p>
    <h1>Not found</h1>
    <p class="notfound-quip">{quip}</p>

    <nav class="notfound-ways" aria-label="Ways out">
      {ways.map((w) => <a href={w.href}>{w.label}</a>)}
    </nav>

    <p class="notfound-note">
      Or search: the button in the header finds regional names and common misspellings
      as well as titles, which is very likely what brought you here.
    </p>
  </main>

  <SiteFooter />
</BaseLayout>
