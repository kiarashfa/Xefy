---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShoppingList from '../components/ShoppingList.svelte';
import { getSite } from '../lib/content/site.ts';

/**
 * The Plan, aggregated into one list. §8.4
 *
 * `client:only` for the same reason as `/plan/`: the whole page is a function
 * of one browser's storage, or of a fragment someone was sent, and neither of
 * those exists at build time.
 */
const base = import.meta.env.BASE_URL;
const site = await getSite();
---

<BaseLayout
  title="Shopping list — Xefy"
  description="Everything your plan needs, summed across recipes and shown in your own units."
  noindex
>
  <SiteHeader />
  <main id="main" class="wrap">
    <div class="page-head">
      <h1 class="page-title">Shopping list</h1>
      <p class="page-lede">
        Every planned dish, added up. Amounts are summed in grams and millilitres and converted
        once, at the end, so nothing accumulates rounding on the way.
      </p>
    </div>

    <ShoppingList client:only="svelte" base={base} staples={site.staples} />

    <noscript>
      <p class="empty-state">
        A shopping list is worked out in your own browser from a plan held there, so this page needs
        JavaScript. Everything else on Xefy works without.
      </p>
    </noscript>
  </main>
  <SiteFooter />
  <script>
    import { initInteractions } from '../lib/client/interactions.ts';
    initInteractions();
  </script>
</BaseLayout>
