---
import RecipeCard from './RecipeCard.astro';

/** The card grid, shared by every listing page so they stay one vocabulary. */
interface Props {
  recipes: any[];
  base: string;
}
const { recipes, base } = Astro.props;
---

<ul class="card-grid">
  {recipes.map((r) => (
    <RecipeCard recipe={r} base={base} />
  ))}
</ul>
