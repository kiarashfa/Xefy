---
/**
 * The site header, on every page.
 *
 * Four nav items is the ceiling; anything further belongs in the
 * footer. Plan ships now, even though the Plan pages themselves come later,
 * because widening the header afterwards means re-checking every layout.
 *
 * The search affordance is required rather than optional: the naming system
 * assumes people can search alternate names, and a site with no way to search
 * is missing a primary function. The search button grows into a field in the
 * header itself, the section links making way for it, and the results drop
 * below it, on whichever page the reader is already on.
 */
const base = import.meta.env.BASE_URL;

/** What each first path segment holds, for the label beside a search result. */
const kinds = {
  recipes: 'Recipe',
  ingredients: 'Ingredient',
  techniques: 'Technique',
  cuisines: 'Cuisine',
  courses: 'Course',
  methods: 'Method',
  diets: 'Diet',
};

const nav = [
  { href: `${base}recipes/`, label: 'Recipes' },
  { href: `${base}ingredients/`, label: 'Ingredients' },
  { href: `${base}what-can-i-make/`, label: 'What can I make' },
  { href: `${base}plan/`, label: 'Plan', count: true },
];

/** The section a page belongs to, so `/recipes/carbonara/` marks "Recipes". */
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

{/*
  Chrome is not content: without this every search excerpt on the site opens
  with "Skip to content Xefy Recipes Ingredients…" before reaching the words
  somebody actually searched for.
*/}
<a class="skip-link" href="#main" data-pagefind-ignore>Skip to content</a>

<header class="site-header" data-pagefind-ignore>
  <div class="wrap header-inner">
    <a class="logo" href={base} data-hs-logo>
      {/* The site mark, same geometry as the favicon: a toque knocked out of a
          disc. The disc takes currentColor (the accent, set on .logo-mark) and
          the hat the page surface, so the pair follows the site's own theme
          rather than the browser's. The crown/band seam is a hole in the hat
          path, so it shows the disc beneath and needs no colour of its own. */}
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="15.5" fill="currentColor"></circle>
        <g transform="translate(16 16.5) scale(0.74) translate(-16 -16.5)">
          <path fill="var(--surface)" fill-rule="evenodd" d="M3.4 21.5C2.5 19.2 2 16.8 2.2 14C2.5 8.8 4.6 5.6 7.6 5.6C10.4 5.6 11.3 8 11.7 10.4C12.1 6.4 13.5 2 16 2C18.5 2 19.9 6.4 20.3 10.4C20.7 8 21.6 5.6 24.4 5.6C27.4 5.6 29.5 8.8 29.8 14C30 16.8 29.5 19.2 28.6 21.5L24.5 21.5L24.5 26.9A2 2 0 0 1 22.5 28.9L9.5 28.9A2 2 0 0 1 7.5 26.9L7.5 21.5ZM7.5 21.5L24.5 21.5L24.5 22.7L7.5 22.7Z"></path>
        </g>
      </svg>
      <span>Xefy</span>
    </a>

    <nav class="desktop-nav" aria-label="Main" data-hs-fade>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span class="nav-label">{item.label}</span>
            {/* Space is reserved before hydration so the count cannot shift the row. */}
            {item.count && <span class="nav-count" data-plan-count aria-hidden="true" />}
          </a>
        ))
      }
    </nav>

    {/*
      The controls are one group, spaced to each other rather than to the nav
      items: they act on the page you are on, where the links beside them leave
      it. Search, theme, about, always in that order, and the menu on a phone.
    */}
    <div class="nav-icons">
      <div class="hs" data-hs data-hs-base={base} data-hs-kinds={JSON.stringify(kinds)}>
        <div class="hs-field" data-hs-field>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <line x1="15.8" y1="15.8" x2="20.5" y2="20.5"></line>
          </svg>
          <input type="search" placeholder="Search dishes and ingredients" aria-label="Search Xefy" autocomplete="off" />
          <button class="hs-close" type="button" data-hs-close aria-label="Close search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M7 7l10 10M17 7 7 17" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
        <button class="icon-btn" type="button" data-hs-button aria-label="Search" aria-expanded="false" aria-controls="site-search" title="Search (press /)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <line x1="15.8" y1="15.8" x2="20.5" y2="20.5"></line>
          </svg>
        </button>
        <div class="hs-panel" id="site-search" data-hs-panel>
          <div class="hs-results" data-hs-results aria-live="polite">
            <p class="hs-status">Every dish and ingredient, including regional names and the spellings people type.</p>
          </div>
        </div>
      </div>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch between light and dark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.5 1.5M18.3 18.3l1.5 1.5M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.5-1.5M18.3 5.7l1.5-1.5"
          ></path>
        </svg>
      </button>
      <a class="icon-btn" href={`${base}about/`} aria-label="About this site">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 11.2v5.1"></path>
          <path d="M12 7.9h.01" stroke-linecap="round"></path>
        </svg>
      </a>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-label="Menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav class="wrap mobile-menu" data-mobile-menu aria-label="Main">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>

<script>
  import { initHeaderSearch } from '../lib/client/header-search.ts';
  initHeaderSearch();
</script>
