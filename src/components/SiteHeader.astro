---
/**
 * The site header, on every page.
 *
 * Four nav items is the ceiling (§19.4); anything further belongs in the
 * footer. Plan ships now, even though the Plan pages themselves come later,
 * because widening the header afterwards means re-checking every layout.
 *
 * The search affordance is required rather than optional: the naming system
 * assumes people can search alternate names, and a site with no way to search
 * is missing a primary function. It opens as a drawer under the header, in
 * place, on whichever page the reader is already on.
 */
const base = import.meta.env.BASE_URL;

const nav = [
  { href: `${base}recipes/`, label: 'Recipes' },
  { href: `${base}ingredients/`, label: 'Ingredients' },
  { href: `${base}what-can-i-make/`, label: 'What Can I Make' },
  { href: `${base}plan/`, label: 'Plan', count: true },
];
---

{/*
  Chrome is not content: without this every search excerpt on the site opens
  with "Skip to content Xefy Recipes Ingredients…" before reaching the words
  somebody actually searched for.
*/}
<a class="skip-link" href="#main" data-pagefind-ignore>Skip to content</a>

<header class="site-header" data-pagefind-ignore>
  <div class="wrap header-inner">
    <a class="logo" href={base}>Xefy</a>

    <nav class="desktop-nav" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href}>
            {item.label}
            {/* Space is reserved before hydration so the count cannot shift the row. */}
            {item.count && <span class="nav-count" data-plan-count aria-hidden="true" />}
          </a>
        ))
      }
      <button class="icon-btn" data-search aria-label="Search" aria-expanded="false" aria-controls="site-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="6.5"></circle>
          <line x1="15.8" y1="15.8" x2="20.5" y2="20.5"></line>
        </svg>
      </button>
      <button class="icon-btn" data-theme-toggle aria-label="Switch between light and dark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.5 1.5M18.3 18.3l1.5 1.5M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.5-1.5M18.3 5.7l1.5-1.5"
          ></path>
        </svg>
      </button>
    </nav>

    <div class="mobile-nav">
      <button class="icon-btn" data-search aria-label="Search" aria-expanded="false" aria-controls="site-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="6.5"></circle>
          <line x1="15.8" y1="15.8" x2="20.5" y2="20.5"></line>
        </svg>
      </button>
      <button class="icon-btn" data-theme-toggle aria-label="Switch between light and dark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.5 1.5M18.3 18.3l1.5 1.5M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.5-1.5M18.3 5.7l1.5-1.5"
          ></path>
        </svg>
      </button>
      <button class="icon-btn" data-menu-toggle aria-label="Menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav class="wrap mobile-menu" data-mobile-menu aria-label="Main">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  {/*
    Search opens in place, under the header, on whatever page the reader is
    already on — the same drawer idiom as the mobile menu rather than a dialog
    over the page or a page of its own. Nothing about searching requires
    leaving, and an overlay costs a focus trap and an inertness claim to get
    right.

    Pagefind's assets are produced by the build, so this is inert in `astro dev`
    and live in a real build. The index reads rendered HTML, which is what makes
    alternate and search-only names findable.
  */}
  <div class="search-drawer" id="site-search" data-search-drawer hidden>
    <div class="wrap search-drawer-inner">
      <div id="pagefind-search"></div>
      <p class="search-hint">
        Every dish and ingredient, including regional names and the spellings people type.
      </p>
    </div>
  </div>
</header>

<link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
<script is:inline define:vars={{ base }}>
  (() => {
    const drawer = document.querySelector('[data-search-drawer]');
    const buttons = [...document.querySelectorAll('[data-search]')];
    if (!drawer || buttons.length === 0) return;

    let loaded = false;
    // Where focus came from, so closing puts it back rather than dropping it.
    let opener = null;

    async function load() {
      if (loaded) return;
      loaded = true;
      try {
        await import(`${base}pagefind/pagefind-ui.js`);
        new window.PagefindUI({
          element: '#pagefind-search',
          showSubResults: true,
          showImages: false,
          /*
           * Required, and its absence is why search never returned anything.
           * The UI script loads the search core itself, from a root-relative
           * `/pagefind/` unless told otherwise — which 404s on a site served
           * from a repository subpath. The failure is silent in the UI: the
           * field works, the query runs, and it sits on "Searching…" forever.
           */
          bundlePath: `${base}pagefind/`,
        });
      } catch {
        document.getElementById('pagefind-search').textContent =
          'Search is available on the published site.';
      }
    }

    function setOpen(open, trigger) {
      // `hidden` is removed a frame before the open attribute so the drawer has
      // a laid-out height to transition from; adding both at once animates from
      // nothing and the box appears instantly.
      if (open) {
        opener = trigger ?? opener;
        drawer.hidden = false;
        requestAnimationFrame(() => drawer.setAttribute('data-open', ''));
        load().then(() => {
          drawer.querySelector('input')?.focus();
        });
      } else {
        drawer.removeAttribute('data-open');
        opener?.focus();
      }
      for (const b of buttons) b.setAttribute('aria-expanded', String(open));
    }

    // Kept in the DOM but out of the tab order while closed, without which a
    // keyboard user tabs into a search field they cannot see.
    drawer.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'grid-template-rows' && !drawer.hasAttribute('data-open')) {
        drawer.hidden = true;
      }
    });

    for (const button of buttons) {
      button.addEventListener('click', () =>
        setOpen(!drawer.hasAttribute('data-open'), button),
      );
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.hasAttribute('data-open')) setOpen(false);
    });
  })();
</script>
