---
/**
 * The site footer, and the only home the browsing indexes have.
 *
 * The header is capped at four items (§19.4) and the taxonomy listings are not
 * among them — they are ways *into* the catalogue rather than destinations, and
 * putting them here keeps them reachable by a reader and by a crawler without
 * competing with the four things the header is for.
 */
const base = import.meta.env.BASE_URL;

const browse = [
  { href: `${base}cuisines/`, label: 'Cuisine' },
  { href: `${base}courses/`, label: 'Course' },
  { href: `${base}methods/`, label: 'Method' },
  { href: `${base}diets/`, label: 'Diet' },
  { href: `${base}techniques/`, label: 'Techniques' },
];
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <nav class="footer-browse" aria-label="Browse">
      <span class="footer-browse-label">Browse by</span>
      {browse.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="footer-meta">
      <span>
        Xefy — free, ad-free and login-free. <a href={`${base}attributions/`}>Image credits</a>.
      </span>
      <span>Nutrition from USDA FoodData Central.</span>
    </div>
  </div>
</footer>
