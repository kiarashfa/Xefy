{
  "name": "xefy",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "node --test \"src/**/*.test.ts\"",
    "build": "npm run test && npm run check:content && astro build && npm run postbuild:index && npm run check:site",
    "postbuild:index": "pagefind --site dist",
    "check:site": "node scripts/integrity/site.ts && node scripts/integrity/site-common.mjs && node scripts/integrity/public-text.mjs Xefy",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "node scripts/integrity/run.ts",
    "check:self": "node scripts/integrity/run.ts --content test-fixtures/broken-content --expect-failure",
    "astro": "astro",
    "check:fixtures": "node scripts/integrity/run.ts --content test-fixtures/engine-content",
    "brand": "node scripts/brand/build.mjs",
    "check:layout": "node scripts/integrity/layout.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "nanostores": "^1.4.2",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.63.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.3",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.0"
  }
}
